{
  "name": "gradientwall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src netlify --diagnostic-level=error",
    "format": "biome format --write src netlify",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
