# ─────────────────────────────────────────────────────────────────────────────
# GradientWall — environment variables
#
# Copy this file to `.env` for local dev (Vite picks it up) and set the same
# vars in the Netlify project settings for production deploys. Never commit
# the real `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (Vite reads VITE_*) ───────────────────────────────────────────
# Bare hostname of your Lemon Squeezy store, e.g. `gradientwall.lemonsqueezy.com`
VITE_LEMONSQUEEZY_STORE=

# ── Backend (Netlify Functions) ────────────────────────────────────────────
# Base URL of the deployed site. Used to build the absolute download link in
# the order email. Set to https://gradientwall.com in production, or to the
# Netlify deploy preview URL for staging tests.
PUBLIC_SITE_URL=

# Random 32+ char secret used to sign the JWT download tokens.
# Generate with: `openssl rand -hex 32`
JWT_SECRET=

# Lemon Squeezy
# - Webhook signing secret (Settings → Webhooks → click your webhook → Signing secret)
LS_WEBHOOK_SECRET=
# - API key (Settings → API → New API key) used by /recover to look up orders
LS_API_KEY=

# Loops (transactional + audiences)
# - API key from https://app.loops.so/settings?page=api
LOOPS_API_KEY=
# - Transactional template ID for "Your pack is ready" emails
LOOPS_TRANSACTIONAL_ID=

# Cloudflare R2 (S3-compatible)
# - Account ID from the R2 dashboard
R2_ACCOUNT_ID=
# - API token credentials (R2 → Manage R2 API Tokens) with read on the packs bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# - Name of the private bucket holding the pack ZIPs (e.g. `gw-packs`)
R2_BUCKET_PACKS=
